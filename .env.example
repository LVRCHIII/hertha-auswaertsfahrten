# Kopiere nach .env: cp .env.example .env
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://dein-projekt-ref.supabase.co
VITE_SUPABASE_ANON_KEY=dein-vollstaendiger-anon-public-key

# Alternativ (Publishable Key):
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google Cloud → APIs & Services → Credentials (Maps JavaScript API + Directions API aktivieren)
VITE_GOOGLE_MAPS_API_KEY=dein-google-maps-api-key
